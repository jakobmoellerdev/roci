{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "roci Helm chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "auth": {
      "type": "object",
      "properties": {
        "allowAnonymous": {
          "type": "boolean"
        },
        "realm": {
          "type": "string",
          "minLength": 1
        },
        "cacheTtlSecs": {
          "type": "integer",
          "minimum": 0
        },
        "htpasswd": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "accessControl": {
          "type": "object",
          "description": "roci [access_control] section; strings, lists and maps only (rendered with toToml)."
        }
      },
      "additionalProperties": false
    },
    "tls": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "metadataHmac": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "properties": {
        "log": {
          "type": "object",
          "properties": {
            "level": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "type": "string",
              "enum": [
                "text",
                "json"
              ]
            }
          },
          "additionalProperties": false
        },
        "http": {
          "type": "object",
          "properties": {
            "timeouts": {
              "type": "object",
              "properties": {
                "readHeaderSecs": {
                  "type": "integer",
                  "minimum": 0
                },
                "idleSecs": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "rateLimit": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "default": {
                  "type": "object",
                  "properties": {
                    "rate": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "burst": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "rate",
                    "burst"
                  ],
                  "additionalProperties": false
                },
                "perMethod": {
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^[A-Z]+$"
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "rate": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "burst": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "rate",
                      "burst"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "properties": {
            "maxBody": {
              "type": "integer",
              "minimum": 0
            },
            "maxUpload": {
              "type": "integer",
              "minimum": 0
            },
            "maxManifest": {
              "type": "integer",
              "minimum": 0
            },
            "maxPage": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "delete": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "storage": {
          "type": "object",
          "properties": {
            "cacheMaxBytes": {
              "type": "integer",
              "minimum": 0
            },
            "dedupe": {
              "type": "boolean"
            },
            "commit": {
              "type": "boolean"
            },
            "gc": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "delaySecs": {
                  "type": "integer",
                  "minimum": 0
                },
                "intervalSecs": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "scrub": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "intervalSecs": {
                  "type": "integer",
                  "minimum": 0
                },
                "maxBytesPerSec": {
                  "type": "integer",
                  "minimum": 0
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "auto",
                    "app"
                  ]
                }
              },
              "additionalProperties": false
            },
            "quota": {
              "type": "object",
              "properties": {
                "maxRepoBytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "maxTotalBytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "maxUploadSessions": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "metadata": {
              "type": "object",
              "properties": {
                "engine": {
                  "type": "string",
                  "enum": [
                    "log",
                    "redb"
                  ]
                },
                "snapshot": {
                  "type": "boolean"
                },
                "compactThresholdBytes": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "telemetry": {
          "type": "object",
          "properties": {
            "sampleRatio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "otlp": {
              "type": "object",
              "properties": {
                "endpoint": {
                  "type": "string"
                },
                "protocol": {
                  "type": "string",
                  "enum": [
                    "grpc",
                    "http"
                  ]
                }
              },
              "additionalProperties": false
            },
            "metrics": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "path": {
                  "type": "string",
                  "pattern": "^/"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "s3": {
      "type": "object",
      "properties": {
        "bucket": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
        },
        "prefix": {
          "type": "string",
          "pattern": "^([a-z0-9._-]+(/[a-z0-9._-]+)*)?$"
        },
        "accessKeyId": {
          "type": "string"
        },
        "multipartPartSize": {
          "type": "integer",
          "minimum": 5242880
        },
        "multipartConcurrency": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "persistence": {
      "type": "object",
      "properties": {
        "size": {
          "type": "string",
          "minLength": 1
        },
        "storageClass": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "ReadWriteOnce",
              "ReadWriteOncePod",
              "ReadWriteMany",
              "ReadOnlyMany"
            ]
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "retentionPolicy": {
          "type": "object",
          "properties": {
            "whenDeleted": {
              "type": "string",
              "enum": [
                "Retain",
                "Delete"
              ]
            },
            "whenScaled": {
              "type": "string",
              "enum": [
                "Retain",
                "Delete"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "resources": {
      "type": "object"
    },
    "hostUsers": {
      "type": "boolean"
    },
    "podSecurityContext": {
      "type": "object",
      "required": [
        "runAsNonRoot",
        "seccompProfile"
      ],
      "properties": {
        "runAsNonRoot": {
          "const": true
        },
        "runAsUser": {
          "type": "integer",
          "minimum": 1
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 1
        },
        "seccompProfile": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "RuntimeDefault",
                "Localhost"
              ]
            }
          }
        }
      }
    },
    "containerSecurityContext": {
      "type": "object",
      "required": [
        "allowPrivilegeEscalation",
        "privileged",
        "readOnlyRootFilesystem",
        "runAsNonRoot",
        "capabilities"
      ],
      "properties": {
        "allowPrivilegeEscalation": {
          "const": false
        },
        "privileged": {
          "const": false
        },
        "readOnlyRootFilesystem": {
          "const": true
        },
        "runAsNonRoot": {
          "const": true
        },
        "runAsUser": {
          "type": "integer",
          "minimum": 1
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 1
        },
        "capabilities": {
          "type": "object",
          "required": [
            "drop"
          ],
          "properties": {
            "drop": {
              "type": "array",
              "contains": {
                "const": "ALL"
              }
            },
            "add": {
              "type": "array",
              "maxItems": 0
            }
          }
        },
        "seccompProfile": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "RuntimeDefault",
                "Localhost"
              ]
            }
          }
        }
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "priorityClassName": {
      "type": "string"
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressFrom": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "NetworkPolicyPeer list; [] = any source."
        },
        "dns": {
          "type": "object",
          "properties": {
            "namespaceSelector": {
              "type": "object"
            },
            "podSelector": {
              "type": "object"
            }
          },
          "required": [
            "namespaceSelector",
            "podSelector"
          ],
          "additionalProperties": false
        },
        "extraEgress": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "NetworkPolicyEgressRule list appended to the registry policy."
        }
      },
      "additionalProperties": false
    },
    "hooks": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "rustfs": {
      "type": "object",
      "description": "Upstream RustFS subchart values.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
