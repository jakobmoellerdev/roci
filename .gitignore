# Rust build artifacts.
/target
**/*.rs.bk

# Coverage artifacts (cargo-llvm-cov). COVERAGE.md is committed; these are not.
/lcov.info
/cobertura.xml
/coverage-html
/coverage-summary.txt
*.profraw
*.profdata

# Conformance artifacts (built/emitted on demand from the submodule).
/spec/distribution-spec/conformance/conformance.test
/spec/distribution-spec/conformance/report.html
/spec/distribution-spec/conformance/junit.xml

# Local roci data directories.
/roci-data

# VitePress docs site (docs/): dependencies and build output.
/docs/node_modules
/docs/.vitepress/dist
/docs/.vitepress/cache

# Editor/OS noise.
.DS_Store
